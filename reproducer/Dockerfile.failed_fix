# Reproducer image — Gogs v0.13.1 (failed fix; CVE-2024-55947's first patch).
# v0.13.1 added path validation but ignored SYMLINKS, so the symlink bypass
# (CVE-2025-8110) still writes outside the repo. The two-trace negative control
# still fires here -> incomplete_patch, not a PoNE.
#
# EFFECT-ONLY (RFC 0003 invariant 8): stock historic Gogs server; the out-of-repo
# arbitrary-file-write EFFECT is exercised by reproducer/driver/, never by a payload
# baked here. Historic source is NOT vendored — cloned + checked out at the pin.
#
# Toolchain note: golang:1.20 + modules mode + bookworm bases (see NOTES.md).
# LIVE-BUILT 2026-09-14 (K8).
FROM golang:1.20-bookworm AS build

ARG GOGS_COMMIT=0c40e600a275d490481cfeea53705810fbe94d9b
ENV CGO_ENABLED=1 \
    TAGS="sqlite sqlite_unlock_notify"

RUN apt-get update && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone https://github.com/gogs/gogs . \
    && git checkout "${GOGS_COMMIT}"

RUN go build -tags "${TAGS}" -o /out/gogs .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -d /home/git -s /bin/bash git

RUN mkdir -p /srv/sentinel && chown git:git /srv/sentinel

COPY --from=build /out/gogs /usr/local/bin/gogs
# Gogs derives its work dir from the binary location by default (/usr/local/bin),
# which the unprivileged git user cannot write. Pin it to the git home.
ENV GOGS_WORK_DIR=/home/git
USER git
WORKDIR /home/git
EXPOSE 3000
ENTRYPOINT ["gogs", "web"]
